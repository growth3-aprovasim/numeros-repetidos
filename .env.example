# =====================================================================
# 🛡️ AEGIS C2 // MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais
# =====================================================================

# Porta do Servidor Web / Painel C2
PORT=3000

# Chave de Integração da API SendFlow (painel > Send API > API Keys)
SENDFLOW_API_KEY=sua_chave_sendflow_aqui

# URL Base da API do SendFlow
SENDFLOW_BASE_URL=https://sendflow.pro/sendapi

# Disparo automático do bot ao iniciar o servidor (true | false)
START_BOT=true
